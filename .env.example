# Copie para .env e preencha. Nunca commite o .env.
ANTHROPIC_API_KEY=
# Modelo padrão para desenvolvimento; use claude-sonnet-5-5 na validação final.
MODEL=claude-haiku-5-5
# Opcionais
EFFORT=medium
MAX_TOKENS=4096
# Data usada como "hoje" (AAAA-MM-DD) para atraso de entrega e prazos de troca.
# Vazia = data real. Os dados de data/ são estáticos (pedidos de 2025-2026).
REFERENCE_DATE=
